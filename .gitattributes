# Normalize line endings to LF so this repo stays clean across Windows, WSL and CI.
# CRLF would otherwise churn on every checkout and re-checkout between the two.
* text=auto eol=lf

# Shell and config files must always be LF, even on Windows.
*.sh text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary-ish / generated artifacts: leave as-is.
*.png binary
*.svg binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary