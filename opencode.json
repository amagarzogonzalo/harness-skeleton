{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Model/provider fields are generated by bin/apply_profile.py from harness.toml + profiles/. Everything else here is hand-written and preserved across `make profile`.",
  "default_agent": "plan",
  "theme": "opencode",
  "autoupdate": true,
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.pem": "deny",
      "**/*credentials*": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.pem": "deny",
      "**/*credentials*": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny"
    },
    "glob": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/.env.template": "allow",
      "**/.env.dist": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny"
    },
    "grep": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/.env.template": "allow",
      "**/.env.dist": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny"
    },
    "task": {
      "*": "deny",
      "explore": "allow",
      "critic": "allow",
      "scribe": "allow",
      "security-reviewer": "allow"
    },
    "doom_loop": "ask",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "tree *": "allow",
      "which *": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make types": "allow",
      "make context": "allow",
      "make evals": "allow",
      "make check": "allow",
      "make modules": "allow",
      "make enable *": "ask",
      "make disable *": "ask",
      "make *": "ask",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run mypy*": "allow",
      "uv run python bin/context_budget.py*": "allow",
      "uv run python bin/lint_agents.py*": "allow",
      "uv run python bin/gate_marker.py*": "allow",
      "uv run python bin/check_modules.py": "allow",
      "uv run python bin/modules.py list": "allow",
      "uv run python bin/modules.py *": "ask",
      "uv run python evals/runner.py": "allow",
      "uv run *": "ask",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add *": "allow",
      "git stash*": "allow",
      "git blame*": "allow",
      "git commit*": "ask",
      "git commit -n*": "deny",
      "git commit*--no-verify*": "deny",
      "git checkout -- *": "ask",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git remote *": "deny",
      "python *": "ask",
      "python3 *": "ask",
      "node *": "ask",
      "bash *": "ask",
      "sh *": "ask",
      "eval *": "deny",
      "* | sh": "deny",
      "* | bash": "deny",
      "curl *": "ask",
      "wget *": "deny",
      "pip install*": "ask",
      "uv add *": "ask",
      "npm i*": "ask",
      "npm install*": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "chmod *": "ask",
      "kill *": "ask",
      "docker *": "ask",
      "env": "deny",
      "printenv*": "deny",
      "set": "deny",
      "cat .env*": "deny",
      "cat *credentials*": "deny",
      "cat *~/.ssh*": "deny",
      "cat *~/.aws*": "deny",
      "cat *.pem": "deny",
      "make evals-accept*": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        }
      },
      "model": "openrouter/anthropic/claude-sonnet-4.5"
    },
    "build": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-sonnet-4.5"
    },
    "critic": {
      "mode": "subagent",
      "description": "Adversarial reviewer. Hunts silent regressions in a diff. Never edits, never proposes fixes.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "make test": "allow",
          "make evals": "allow"
        }
      },
      "model": "openrouter/anthropic/claude-sonnet-4.5"
    },
    "scribe": {
      "mode": "subagent",
      "description": "Mechanical documentation: changelogs, docstrings, README tables. No logic changes.",
      "permission": {
        "edit": {
          "*": "deny",
          "**/*.md": "allow",
          "**/*.mdx": "allow",
          "**/*.rst": "allow",
          "**/*.txt": "allow"
        },
        "bash": {
          "*": "deny",
          "make lint": "allow",
          "git diff*": "allow"
        }
      },
      "model": "openrouter/google/gemini-2.5-flash"
    },
    "security-reviewer": {
      "model": "openrouter/anthropic/claude-sonnet-4.5"
    }
  },
  "command": {
    "check": {
      "template": "Run `make check`. If it fails, fix the smallest thing that makes it pass, then re-run. Do not edit evals/snapshots/ or raise a budget to pass. Report each fix in one line."
    },
    "loop": {
      "description": "Bounded edit-run-inspect loop until a named check passes; run from the build agent.",
      "template": "Follow `.opencode/skills/loop/SKILL.md`. The user supplied: $ARGUMENTS\n\nInfer missing pieces instead of stopping:\n- GOAL: use what the user asked for. If unstated, infer it from the request and repo, and state it in one line.\n- CHECK: use what the user gave. Otherwise pick the strongest available proof (project gate, nearest test, build, repro, or a manual probe), say which and why, and proceed. If none exists, create the smallest one.\n- CAP: default 5 when absent.\n\nOnly ask if \"done\" is genuinely ambiguous and a wrong guess would be costly. EVIDENCE is artifacts/loop.md. Establish a baseline: run CHECK before the first change; if it already passes, stop and report. Echo the header block (GOAL, CHECK, CAP, EVIDENCE) before editing, marking inferred fields. Then iterate: one hypothesis, smallest change, run CHECK, append the iteration block to artifacts/loop.md. Use a fast reliable check each iteration and the full gate once at the end. Stop when the check passes or continuing is not worth it. Keep the guardrails. Do not commit or push. End with the STATUS block."
    },
    "review": {
      "template": "Run `git diff` against the base branch, then hand the diff to the @critic subagent. Report the critic's findings verbatim, then state which you agree with and which you don't, with reasons."
    },
    "handoff": {
      "template": "Follow .opencode/skills/ship/SKILL.md. Produce the handover block and stop. Do not commit."
    },
    "context": {
      "template": "Run `make context`. If the always-on budget is exceeded, propose what to cut \u2014 moving a procedure from AGENTS.md into a skill is almost always the answer. Do not raise the budget without saying why in the same message."
    }
  },
  "mcp": {},
  "tools": {
    "todowrite": true,
    "todoread": true
  },
  "_generated_by_apply_profile": {
    "profile": "balanced",
    "roles": {
      "plan": "anthropic/claude-sonnet-4.5",
      "build": "anthropic/claude-sonnet-4.5",
      "review": "anthropic/claude-sonnet-4.5",
      "scribe": "google/gemini-2.5-flash",
      "judge": "anthropic/claude-sonnet-4.5",
      "small": "google/gemini-2.5-flash"
    },
    "module_agents": [],
    "note": "Generated. Edit harness.toml or profiles/, then `make profile`."
  },
  "model": "openrouter/anthropic/claude-sonnet-4.5",
  "small_model": "openrouter/google/gemini-2.5-flash",
  "provider": {
    "openrouter": {
      "models": {
        "anthropic/claude-sonnet-4.5": {
          "options": {
            "provider": {
              "sort": "throughput",
              "allow_fallbacks": true,
              "require_parameters": true,
              "data_collection": "deny"
            },
            "transforms": []
          }
        },
        "google/gemini-2.5-flash": {
          "options": {
            "provider": {
              "sort": "throughput",
              "allow_fallbacks": true,
              "require_parameters": true,
              "data_collection": "deny"
            },
            "transforms": []
          }
        }
      }
    }
  }
}
